#!/usr/bin/python3
"""Root-owned sudo target, executed as xhibit; accepts only one generated basename."""
import os
import re
import signal
import stat
import subprocess
import sys

# Shorter than the CDU caller's default 60 second screenshotTimeout.
CAPTURE_TIMEOUT = 50

if len(sys.argv) != 2 or re.match(r'^[a-f0-9]{32}-www-data\Z', sys.argv[1]) is None:
    sys.exit(2)

def interrupted(signum, frame):
    raise SystemExit(1)


def owned(info):
    return info.st_uid == os.geteuid()


def stream_capture(path):
    # Never follow a link or open a FIFO/device, and stream only a single-link
    # regular file created by this capture account.
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return
    with os.fdopen(fd, 'rb') as stream:
        info = os.fstat(stream.fileno())
        if stat.S_ISREG(info.st_mode) and owned(info) and info.st_nlink == 1:
            sys.stdout.buffer.write(stream.read())


def remove(path):
    try:
        if owned(os.lstat(path)):
            os.unlink(path)
    except OSError:
        pass


signal.signal(signal.SIGTERM, interrupted)
target = '/tmp/' + sys.argv[1] + '.png'
# A pre-existing name was not created by this capture; do not write through it.
if os.path.lexists(target):
    sys.exit(1)
process = None
try:
    # Capture and cleanup both run as the image owner. Apache cannot unlink an
    # xhibit-owned file in a sticky /tmp directory merely because it can read it.
    process = subprocess.Popen(['/home/xhibit/bin/screencapture.sh', '-f', sys.argv[1]],
                               stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL)
    try:
        process.wait(timeout=CAPTURE_TIMEOUT)
    except subprocess.TimeoutExpired:
        raise SystemExit(1)
    stream_capture(target)
finally:
    if process is not None and process.poll() is None:
        process.kill()
        process.wait()
    remove(target)
